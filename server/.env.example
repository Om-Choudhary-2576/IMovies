# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/imovies
# If left blank or connection fails, the server automatically starts an in-memory MongoDB instance for local dev & testing.
MONGODB_URI=

# JWT Secret & Expiration
JWT_SECRET=imovies_super_secret_jwt_key_2026_cinema_secure!
JWT_EXPIRE=7d

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Email Service Credentials (for password reset)
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=no-reply@imovies.com

# Optional: Payment Gateway Credentials (e.g. Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
